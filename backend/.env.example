PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Local PostgreSQL. Railway can use DATABASE_URL instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=team_task_manager
DB_USER=postgres
DB_PASSWORD=postgres

# Railway PostgreSQL sets this automatically if referenced from the database service.
# DATABASE_URL=postgresql://user:password@host:port/database
